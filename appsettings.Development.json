{
  "ConnectionStrings": {
    "CourseCoreDatabase": "Host=127.0.0.1;Port=5432;Database=coursecore;Username=postgres;Password=root;Timeout=15;Command Timeout=60"
  },
  "Jwt": {
    "Issuer": "CourseCore",
    "Audience": "CourseCore",
    "SecretKey": "development-only-change-this-secret-key-with-at-least-32-characters",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Auth": {
    "ExposeRefreshTokenInBody": false,
    "AllowRefreshTokenInBodyFallback": true,
    "RefreshTokenCookie": {
      "Name": "coursecore_refresh_token",
      "Path": "/api/auth",
      "SameSite": "Lax",
      "Secure": false,
      "MaxAgeDays": 7
    }
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 20,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Refresh": {
      "PermitLimit": 60,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Logout": {
      "PermitLimit": 60,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "Progress": {
    "LessonCompletionThresholdPercent": 90
  },
  "Media": {
    "Playback": {
      "SignedUrlExpirationMinutes": 10,
      "SigningSecret": "development-only-media-signing-secret-at-least-32-chars",
      "BaseUrl": "/media",
      "AllowedStorageProviders": [
        "Local"
      ]
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
