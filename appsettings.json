{
  "ConnectionStrings": {
    "CourseCoreDatabase": ""
  },
  "Jwt": {
    "Issuer": "CourseCore",
    "Audience": "CourseCore",
    "SecretKey": "",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Auth": {
    "ExposeRefreshTokenInBody": false,
    "AllowRefreshTokenInBodyFallback": false,
    "RefreshTokenCookie": {
      "Name": "coursecore_refresh_token",
      "Path": "/api/auth",
      "SameSite": "Lax",
      "Secure": false,
      "MaxAgeDays": 7
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
