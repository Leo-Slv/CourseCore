# Copy to .env on the EC2 host (chmod 600). Never commit the real file.
# ASPNETCORE_ENVIRONMENT, URLS and FORWARDEDHEADERS are set in docker-compose.yml.

# --- Used by docker-compose.yml itself (also read from this .env) ---
COURSECORE_IMAGE=ghcr.io/REPLACE_OWNER/coursecore:latest
API_HOST=api.REPLACE-WITH-ELASTIC-IP-DASHED.sslip.io

# --- Neon (use the *pooled* host for the app; direct host only for migrations) ---
ConnectionStrings__CourseCoreDatabase=Host=REPLACE-pooler.REGION.aws.neon.tech;Port=5432;Database=neondb;Username=REPLACE;Password=REPLACE;SSL Mode=Require;Trust Server Certificate=true;Timeout=30;Command Timeout=60

# --- Secrets: generate with `openssl rand -base64 48`; the two MUST differ ---
Jwt__SecretKey=REPLACE_WITH_RANDOM_JWT_SECRET_AT_LEAST_32_CHARACTERS
Media__Playback__SigningSecret=REPLACE_WITH_DIFFERENT_RANDOM_MEDIA_SECRET_AT_LEAST_32_CHARACTERS
Jwt__Issuer=CourseCore
Jwt__Audience=CourseCore

# --- Frontend (Vercel) ---
Cors__AllowedOrigins__0=https://REPLACE-your-app.vercel.app
Frontend__BaseUrl=https://REPLACE-your-app.vercel.app

# --- Refresh cookie ---
# Option A (recommended): Vercel rewrites /api/* to this API, so the browser sees
# one origin -> keep Lax. Option B (direct cross-site calls): set SameSite=None.
Auth__RefreshTokenCookie__Secure=true
Auth__RefreshTokenCookie__SameSite=Lax

# --- Media: Local playback is not usable on this host; use YouTube and/or S3 ---
Media__Playback__BaseUrl=/media
Media__Playback__AllowedStorageProviders__0=YouTube
# To enable S3 add __1=S3 and fill the block below. Leave the keys empty to use
# the EC2 instance role instead of static access keys (preferred).
Media__S3__BucketName=
Media__S3__Region=
Media__S3__AccessKeyId=
Media__S3__SecretAccessKey=

# --- Third parties ---
Turnstile__SecretKey=REPLACE_WITH_CLOUDFLARE_TURNSTILE_SECRET_KEY
Resend__ApiKey=REPLACE_WITH_RESEND_API_KEY
Resend__FromAddress=REPLACE_WITH_VERIFIED_RESEND_FROM_ADDRESS
Resend__FromName=CourseCore

# --- Stripe (TEST mode only; production startup rejects sk_live_) ---
Stripe__SecretKey=sk_test_REPLACE
Stripe__WebhookSecret=whsec_REPLACE

Seed__Admin__Enabled=false
