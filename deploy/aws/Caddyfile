{$API_HOST} {
	encode zstd gzip

	# /health/ready and /health expose DB state; only liveness is public
	# (see Docs/production-configuration.md).
	@internalHealth path /health /health/ready
	respond @internalHealth 404

	# Matches Kestrel's 1 MiB limit so oversized bodies are rejected early.
	request_body {
		max_size 1MB
	}

	reverse_proxy coursecore-api:8080
}
